# =============================================================================
# QuantEdge Platform — Environment Configuration (Example)
# Copy this file to .env and fill in your values
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=postgres
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=postgres

# Connection string for ML service
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_SECRET

# ─── Encryption (AES key for broker API credentials) ──────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

# ─── Broker ───────────────────────────────────────────────────────────────────
# Options: PAPER, DELTA, ALPACA
BROKER_ACTIVE=PAPER

# Alpaca (only needed if BROKER_ACTIVE=ALPACA)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Paper Trading ────────────────────────────────────────────────────────────
QUANTEDGE_PAPER_SYMBOLS=BTCUSDT,ETHUSDT
QUANTEDGE_PAPER_BALANCE=500.0
QUANTEDGE_PAPER_PEAK_EQUITY=500.0
# Options: AUTONOMOUS, HUMAN_IN_LOOP
QUANTEDGE_PAPER_MODE=AUTONOMOUS

# ─── Market Data Sync ─────────────────────────────────────────────────────────
QUANTEDGE_SYNC_SYMBOLS=BTCUSD,ETHUSD
QUANTEDGE_SYNC_TIMEFRAMES=15m,1h,4h

# ─── ML Service ───────────────────────────────────────────────────────────────
QUANTEDGE_ML_URL=http://localhost:5001
ML_MODEL_DIR=./models
ML_FEATURE_COLLECTION=false

# Meta-Labeler confidence threshold
QUANTEDGE_META_THRESHOLD=0.55
QUANTEDGE_META_RETRAIN_SYMBOLS=BTCUSDT,ETHUSDT

# ─── AI (Claude agent — optional) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
FRED_API_KEY=DEMO_KEY

# ─── Telegram Bot (optional) ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ─── Kafka (optional, disabled by default) ────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── External APIs ────────────────────────────────────────────────────────────
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ─── Pillar C: Risk & Execution ─────────────────────────────────────────────
MIN_CONFIDENCE_THRESHOLD=0.55
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.05
MAX_TOTAL_EXPOSURE=3.0
MAX_DRAWDOWN=0.08
DAILY_LOSS_LIMIT=5000
DAILY_VAR_LIMIT=10000
SLIPPAGE_THRESHOLD=0.02
LIVE_TRADING=false
LIVE_TRADING_CONFIRM=no
KILL_SWITCH_DIR=./flags
